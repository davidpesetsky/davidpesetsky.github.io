---
---
<div class="pub-row">

  {%- if entry.preview -%}
  <div class="col-sm-2 abbr">
    {%- if entry.preview contains '://' -%}
      <img class="preview z-depth-1 rounded" src="{{ entry.preview }}">
    {%- else -%}
      <img class="preview z-depth-1 rounded" src="{{ entry.preview | prepend: '/assets/img/publication_preview/' | relative_url }}">
    {%- endif -%}
  </div>
  {%- endif -%}

  <div class="col-sm-auto">

    {%- comment -%} Title {%- endcomment -%}
<div class="pub-title{% if entry.url %} pub-title-linked{% endif %}">
  {%- if entry.url -%}
    <a href="{{ entry.url }}">{{- entry.title | markdownify | remove: '<p>' | remove: '</p>' | strip -}}</a>
  {%- else -%}
    {{ entry.title | markdownify | remove: '<p>' | remove: '</p>' | strip }}
  {%- endif -%}
</div>

    {%- comment -%} Authors {%- endcomment -%}
    <div class="pub-authors">
      {{- entry.author -}}
    </div>

{%- comment -%} Venue + year {%- endcomment -%}
<div class="pub-venue">
  {%- if entry.type == "unpublished" -%}
    Unpublished ms.
  {%- elsif entry.booktitle -%}
    {%- if entry.type == "incollection" or entry.type == "inbook" -%}
      <em>In</em>:
      {%- if entry.editor -%}
        {%- if entry.editor contains " and " %} {{ entry.editor }} (eds.),
        {%- else %} {{ entry.editor }} (ed.),
        {%- endif -%}
      {%- endif -%}
      <em> {{ entry.booktitle }}</em>
    {%- else -%}
      <em>{{ entry.booktitle }}</em>
    {%- endif -%}
  {%- elsif entry.journal -%}
    <em>{{ entry.journal }}</em>
  {%- endif -%}
  {%- if entry.volume -%}, {{ entry.volume }}{%- endif -%}
  {%- if entry.number -%}({{ entry.number }}){%- endif -%}
  {%- if entry.pages -%}, pp. {{ entry.pages }}{%- endif -%}
  {%- if entry.year -%}, {{ entry.year }}{%- endif -%}.
</div>

    {%- comment -%} Note {%- endcomment -%}
	{%- if entry.note -%}
<div class="pub-note">[{{ entry.note | markdownify | remove: '<p>' | remove: '</p>' | strip }}]</div>
{%- endif -%}

    {%- comment -%} Inline links: DOI and HTML {%- endcomment -%}
    {%- assign has_links = false -%}
    {%- if entry.doi -%}{%- assign has_links = true -%}{%- endif -%}
    {%- if entry.html -%}{%- assign has_links = true -%}{%- endif -%}
    {%- if entry.pdf -%}{%- assign has_links = true -%}{%- endif -%}
    {%- if entry.arxiv -%}{%- assign has_links = true -%}{%- endif -%}

    {%- if has_links -%}
    <div class="pub-links">
      {%- if entry.doi -%}
        <a href="https://doi.org/{{ entry.doi }}" target="_blank" rel="noopener">doi:{{ entry.doi }}</a>
        {%- if entry.html or entry.pdf or entry.arxiv -%} &nbsp;·&nbsp; {%- endif -%}
      {%- endif -%}
      {%- if entry.html -%}
        <a href="{{ entry.html }}" target="_blank" rel="noopener">{{ entry.html }}</a>
        {%- if entry.pdf or entry.arxiv -%} &nbsp;·&nbsp; {%- endif -%}
      {%- endif -%}
      {%- if entry.pdf -%}
        {%- if entry.pdf contains '://' -%}
          <a href="{{ entry.pdf }}" target="_blank" rel="noopener">PDF</a>
        {%- else -%}
          <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" target="_blank" rel="noopener">PDF</a>
        {%- endif -%}
        {%- if entry.arxiv -%} &nbsp;·&nbsp; {%- endif -%}
      {%- endif -%}
      {%- if entry.arxiv -%}
        <a href="https://arxiv.org/abs/{{ entry.arxiv }}" target="_blank" rel="noopener">arXiv:{{ entry.arxiv }}</a>
      {%- endif -%}
    </div>
    {%- endif -%}

  </div>
</div>
